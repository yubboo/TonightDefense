{
  "project": "TonightDefense",
  "displayName": "今晚守城",
  "architectureVersion": "3.3.0",
  "engine": "Cocos Creator 3.8.8",
  "rulesFile": "AGENTS.md",
  "domains": [
    {
      "id": "hero",
      "name": "英雄域",
      "path": "assets/scripts/systems/hero",
      "singleSourceRules": [
        "CharacterCatalog owns playable character identity",
        "ProfessionCatalog owns profession combat base data",
        "ProfessionSkillCatalog owns profession skill modules",
        "ProfessionSkillRunState owns in-run skill levels",
        "EquipmentLoadoutService owns hero equipment combat modifiers",
        "HeroSkillRuntime consumes CombatEventBus/EnemyStatusSystem instead of owning enemy state",
        "HeroRunStatState owns in-run attack, defense, max-HP, move-speed and dodge growth levels",
        "HeroRunUpgradeService is the only mixed skill/stat three-choice entry",
        "MainHeroController is the only player movement runtime",
        "CompanionBattleController owns AI global targeting, chase and walk-back behavior using CharacterCombatant moveSpeed"
      ],
      "modules": {
        "character": [
          "data",
          "selection",
          "player",
          "companion",
          "party",
          "stats",
          "visual",
          "animation"
        ],
        "profession": [
          "definition",
          "data"
        ],
        "skill": [
          "data",
          "runtime",
          "effect",
          "targeting",
          "upgrade"
        ],
        "progression": [
          "experience",
          "levelup",
          "recruitment"
        ],
        "equipment": [
          "EquipmentLoadoutService.ts"
        ]
      }
    },
    {
      "id": "battle",
      "name": "战斗域",
      "path": "assets/scripts/systems/battle",
      "modules": [
        "combat",
        "enemy",
        "objective",
        "targeting",
        "drop",
        "runtime",
        "statistics",
        "view",
        "data"
      ],
      "singleSourceRules": [
        "EnemyController owns enemy life, movement, attack and death facts",
        "CombatEventBus only publishes completed combat facts",
        "EnemyStatusSystem owns enemy slow, stun, freeze, taunt and hunter mark state",
        "BattleTargetRegistry owns live hero target registration and lookup",
        "DefenseObjectiveService/CoreHealth owns revive channels and tower-HP revive cost for all heroes"
      ]
    },
    {
      "id": "level",
      "name": "关卡域",
      "path": "assets/scripts/systems/level",
      "modules": [
        "stage",
        "wave",
        "map",
        "runtime"
      ]
    },
    {
      "id": "storage",
      "name": "存储/物品域",
      "path": "assets/scripts/systems/storage",
      "modules": [
        "inventory",
        "item",
        "warehouse"
      ]
    },
    {
      "id": "economy",
      "name": "经济域",
      "path": "assets/scripts/systems/economy",
      "modules": [
        "currency",
        "legacy"
      ]
    },
    {
      "id": "feature",
      "name": "功能域",
      "path": "assets/scripts/systems/feature",
      "modules": [
        "main-menu",
        "pause",
        "settings",
        "stamina",
        "tutorial"
      ]
    },
    {
      "id": "gameplay",
      "name": "玩法会话域",
      "path": "assets/scripts/systems/gameplay",
      "modules": [
        "mode",
        "rules",
        "runtime"
      ]
    },
    {
      "id": "reward",
      "name": "奖励域",
      "path": "assets/scripts/systems/reward",
      "modules": [
        "data"
      ]
    },
    {
      "id": "account",
      "name": "账号域",
      "path": "assets/scripts/systems/account",
      "modules": [
        "auth",
        "config",
        "model",
        "platform"
      ]
    },
    {
      "id": "audio",
      "name": "音频域",
      "path": "assets/scripts/systems/audio",
      "modules": [
        "AudioManager.ts",
        "GameAudioSettings.ts"
      ]
    },
    {
      "id": "ui",
      "name": "界面域",
      "path": "assets/scripts/ui",
      "modules": [
        "layout",
        "hud",
        "input",
        "panels",
        "resources",
        "boot"
      ],
      "singleSourceRules": [
        "BattleHudLayout owns battle-screen visibleSize/SafeArea coordinate conversion",
        "HUD reads runtime state and does not own combat state",
        "BattleWorld scaling remains in BattleWorldService and is not duplicated by HUD layout"
      ]
    }
  ]
}
